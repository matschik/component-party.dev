{
  "name": "component-party.dev",
  "version": "2.0.0",
  "private": true,
  "repository": "github:matschik/component-party.dev",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "format": "vp fmt",
    "lint": "vp lint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:ci": "vp fmt && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vp lint",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "build:content": "node scripts/generateContent.ts --no-cache",
    "build:progress": "node scripts/generateReadMeProgress.ts",
    "prepare": "vp config --no-agent && svelte-kit sync || true",
    "test:unit": "vp test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test": "vp test --run && playwright test",
    "check:package-manager": "node scripts/check-package-manager.js"
  },
  "dependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "just-throttle": "^4.2.0",
    "lz-string": "^1.5.0",
    "runed": "^0.37.1"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.535",
    "@iconify/tailwind4": "^1.2.3",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/markdown-it": "^4.4.3",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@sveltejs/vite-plugin-svelte-inspector": "5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/folder-hash": "^4.0.4",
    "@types/markdown-it": "^14.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "autoprefixer": "^10.6.1",
    "chokidar": "^5.0.0",
    "eslint-plugin-svelte": "^3.23.0",
    "folder-hash": "^4.1.3",
    "just-kebab-case": "^4.2.0",
    "markdown-it": "^14.2.0",
    "micache": "^2.4.1",
    "package-directory": "^8.2.0",
    "prettier": "^3.9.9",
    "satori": "^0.26.0",
    "shiki": "^4.4.3",
    "svelte": "5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@resvg/resvg-js"
    ],
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
      "vitest": "5.0.1",
      "yaml": ">=2.8.3"
    }
  }
}

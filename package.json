{
  "name": "component-party.dev",
  "version": "2.0.0",
  "private": true,
  "repository": "github:matschik/component-party.dev",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#generated/*": "./src/generatedContent/*",
    "#frameworks": "./frameworks.ts"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "format": "vp fmt",
    "lint": "vp lint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:ci": "vp fmt && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vp lint",
    "check:toolchain": "bash scripts/check-toolchain.sh",
    "check:deps": "knip --include dependencies,unlisted,unresolved,binaries",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "build:content": "node scripts/generateContent.ts --no-cache",
    "build:progress": "node scripts/generateReadMeProgress.ts",
    "prepare": "vp config --no-agent && svelte-kit sync || true",
    "test:unit": "vp test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test": "vp test --run && playwright test"
  },
  "dependencies": {
    "just-throttle": "^4.2.0",
    "lz-string": "^1.5.0",
    "runed": "^0.37.1"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.544",
    "@iconify/tailwind4": "^1.2.3",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/markdown-it": "^4.5.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/folder-hash": "^4.0.4",
    "@types/node": "^26.6.5",
    "chokidar": "^5.0.0",
    "eslint-plugin-svelte": "^3.23.1",
    "folder-hash": "^4.1.4",
    "just-kebab-case": "^4.2.0",
    "knip": "^6.41.0",
    "markdown-it": "^15.0.3",
    "micache": "^2.4.1",
    "package-directory": "^8.2.0",
    "prettier": "^3.9.10",
    "satori": "^0.62.0",
    "shiki": "^4.5.0",
    "svelte": "5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.8.1"
}

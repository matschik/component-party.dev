{
  "name": "component-party",
  "compatibility_date": "2026-10-01",
  "routes": [
    {
      "pattern": "component-party.dev",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "../../../dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  },
  "account_id": "9ee09e0f8ff49b7507f6bd03e1c1eaec",
  "main": "static-edge.mjs",
  "no_bundle": false,
  "durable_objects": {
    "bindings": []
  },
  "queues": {
    "producers": [],
    "consumers": []
  },
  "triggers": {
    "crons": []
  },
  "containers": [],
  "workflows": [],
  "version_metadata": {
    "binding": "__VOID_VERSION_METADATA"
  }
}
